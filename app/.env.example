# Konfigurasi publik klien Supabase (aman di-bundle ke browser).
# Salin file ini ke `.env` lalu isi dengan kredensial project Supabase Anda.
#
# ⚠️ HANYA config publik di sini. Service-role key & API key LLM/email TIDAK boleh
# di client — simpan di Supabase Vault → Edge Function (D20, Aturan inti #10).
#
# Bila kedua nilai kosong, app otomatis fallback ke mock in-memory (dev tanpa Supabase).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
